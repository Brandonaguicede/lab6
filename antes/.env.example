# Auth0 SPA and API identifiers. Replace every example value outside Git.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.una-chat.example
AUTH0_CLIENT_ID=your-public-spa-client-id

# Canonical origin for Express, Auth0 callback/logout, Socket.IO and CORS.
# Use HTTPS outside localhost/127.0.0.1.
APP_URL=http://127.0.0.1:3000

# Optional namespaced claim containing a display name in the access token.
AUTH0_DISPLAY_NAME_CLAIM=

# Never enable AUTH_TEST_MODE outside automated tests.
AUTH_TEST_MODE=0
