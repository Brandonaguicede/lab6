{
  "dependencies": {
    "express": "4.22.3",
    "mocha": "10.8.2",
    "socket.io": "4.8.4"
  },
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha \"test/**/*.js\"",
    "test:integration": "jest tests/integration --runInBand --env=node",
    "test:e2e": "playwright test --project=chromium",
    "harness": "node harness/run.js"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.15.0",
    "@playwright/test": "^1.64.1",
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.4"
  }
}
