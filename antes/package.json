{
  "dependencies": {
    "express": "4.22.3",
    "socket.io": "4.8.4"
  },
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha \"test/**/*.js\"",
    "test:integration": "jest tests/integration --runInBand --env=node",
    "test:e2e": "playwright test --project=chromium",
    "harness": "node harness/run.js"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.15.0",
    "@playwright/test": "^1.64.1",
    "jest": "^30.5.2",
    "mocha": "^12.0.3",
    "socket.io-client": "^4.8.4"
  },
  "overrides": {
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "proxy-addr": "2.0.8",
    "socket.io-parser": "4.2.7",
    "ws": "8.22.0"
  }
}
